{
  "name": "@workspace/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:contract": "jest tests/contract",
    "test:unit": "jest tests/unit",
    "seed": "node seed.js",
    "db:init": "node -e \"require('./migrations').initMigrations()\"",
    "db:migrate": "node -e \"require('./migrations').runMigrations()\"",
    "db:migrate:generate": "node migrations/scripts/generate.js",
    "db:migrate:preview": "node migrations/scripts/generate.js --preview",
    "postinstall": "node scripts/patch-auto-migrations.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "sequelize-auto-migrations": "^1.0.3",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
