{
  "info": {
    "name": "TKD Tournament API",
    "description": "Postman collection for the Meedan TKD Tournament Management System\n\nBase URL: {{base_url}}\nAuth: Bearer token via {{auth_token}}\n\nDocumented Endpoints:\n- Auth: POST /auth/register, POST /auth/login\n- Tournaments: GET/POST /tournaments, GET/PUT/DELETE /tournaments/:id\n- Categories: GET /categories/:categoryId\n- Players: GET/POST /players\n- Clubs: GET/POST /clubs\n- Matches: GET /matches\n- Live Matches: GET /matches/:matchId/live, POST /matches/:matchId/live/action|points|points/undo|penalty|injury|exclude, GET /matches/:matchId/suggestions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "tournament_id",
      "value": ""
    },
    {
      "key": "player_id",
      "value": ""
    },
    {
      "key": "club_id",
      "value": ""
    },
    {
      "key": "match_id",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('auth_token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Coach Ahmed\",\n  \"email\": \"coach@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"coach\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": [
            {
              "name": "Register Success (201)",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/auth/register"
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": \"507f1f77bcf86cd799439011\",\n    \"fullName\": \"Coach Ahmed\",\n    \"email\": \"coach@example.com\",\n    \"role\": \"coach\"\n  },\n  \"token\": \"eyJhbGciOiJIUzI1NiIs...\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('auth_token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coach@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": [
            {
              "name": "Login Success (200)",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/auth/login"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": \"507f1f77bcf86cd799439011\",\n    \"fullName\": \"Coach Ahmed\",\n    \"email\": \"coach@example.com\",\n    \"role\": \"coach\"\n  },\n  \"token\": \"eyJhbGciOiJIUzI1NiIs...\"\n}"
